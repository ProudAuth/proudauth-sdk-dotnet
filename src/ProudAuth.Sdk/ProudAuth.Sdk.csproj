<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>0.2.0</Version>
    <PackageId>ProudAuth.Sdk</PackageId>
    <Description>ProudAuth token verification, introspection, support access, bounded revocation state, OIDC BFF and administration client.</Description>
    <RepositoryUrl>https://github.com/proudbase/proudauth-sdk-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://docs.proudauth.com/</PackageProjectUrl>
    <Authors>The ProudAuth Authors</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>proudauth;oauth2;oidc;jwt</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ProudAuth.Sdk.Tests" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../NOTICE" Pack="true" PackagePath="/" />
    <None Include="../../third-party/BouncyCastle-LICENSE.md" Pack="true" PackagePath="third-party/" />
  </ItemGroup>
</Project>
